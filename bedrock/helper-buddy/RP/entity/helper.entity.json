        "animate": [
          "look_at_target",
          "walk",
          "bob",
          "hold",
          "work_controller",
          "ko_controller"
        ]
      },
      "animations": {
        "look_at_target": "animation.helper.look_at_target",
        "walk": "animation.helper.walk",
        "bob": "animation.helper.bob",
        "hold": "animation.helper.hold",
        "work": "animation.helper.work",
        "work_controller": "controller.animation.helper.work",
        "ko": "animation.helper.ko",
        "ko_controller": "controller.animation.helper.ko"
      }
    }
  }
}