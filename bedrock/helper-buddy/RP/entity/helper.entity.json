      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/helper"
      },
      "geometry": {
        "default": "geometry.helper"
      },
      "render_controllers": [
        "controller.render.helper"
      ],
      "spawn_egg": {
        "base_color": "#f2b632",
        "overlay_color": "#2f5aa8"
      },
