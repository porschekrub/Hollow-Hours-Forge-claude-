{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "hollowhours_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.hollowhours.fabric.HHFabric"],
    "client": ["com.hollowhours.fabric.HHFabricClient"]
  },
  "mixins": ["${pp_shim}.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "geckolib": "*",
    "forgeconfigapiport": "*"
  }
}
